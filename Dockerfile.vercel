# Vercel Container Image — ASP.NET Core 10
# Vercel auto-detects Dockerfile.vercel and builds the container image.
# The app must listen on $PORT (injected by Vercel at runtime).

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copy everything and build
COPY . .
RUN dotnet restore && dotnet publish -c Release -o /app

# Runtime image
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app .

# Copy entrypoint that adapts to Vercel's $PORT
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Default port — Vercel overrides via PORT env var
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080

ENTRYPOINT ["/entrypoint.sh"]
