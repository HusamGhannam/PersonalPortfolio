# Vercel Container Image — ASP.NET Core 10
# Vercel auto-detects Dockerfile.vercel and builds the container image.
# The app must listen on $PORT (injected by Vercel at runtime).
# .NET 10 uses HTTP_PORTS env var which works with Vercel's PORT.

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copy everything and build
COPY . .
RUN dotnet restore && dotnet publish -c Release -o /app

# Runtime image
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app .

# .NET 10 reads HTTP_PORTS env var — Vercel sets PORT which maps to HTTP_PORTS
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080

ENTRYPOINT ["dotnet", "PersonalPortfolio.dll"]
