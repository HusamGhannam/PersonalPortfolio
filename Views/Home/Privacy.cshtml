@{
    ViewData["Title"] = "Privacy Policy";
}

<section class="page-header">
    <div class="container">
        <span class="section-eyebrow">Legal</span>
        <h2>Privacy Policy</h2>
    </div>
</section>

<section style="padding-bottom: var(--section-gap);">
    <div class="privacy-section container">
        <div class="reveal">
            <p>Your privacy is important. This portfolio website is a personal project and does not collect, store, or share any personal data beyond what you voluntarily submit through the contact form.</p>

            <h3 style="font-size: 1.1rem; margin-top: 2rem;">Data Collection</h3>
            <p>Contact form submissions (name, email, subject, message) are stored securely and used solely for responding to your inquiry. No tracking cookies or analytics are used.</p>

            <h3 style="font-size: 1.1rem; margin-top: 2rem;">Data Security</h3>
            <p>All data is handled with appropriate security measures. No data is shared with third parties.</p>

            <h3 style="font-size: 1.1rem; margin-top: 2rem;">Contact</h3>
            <p>For any privacy-related concerns, please use the <a asp-controller="Home" asp-action="ContactMe">contact form</a>.</p>
        </div>
    </div>
</section>
