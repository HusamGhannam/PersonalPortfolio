@model List<PersonalPortfolio.Models.Certificate>

@{
    ViewData["Title"] = "Certificates";
}

<section class="page-header">
    <div class="container">
        <span class="section-eyebrow">Credentials</span>
        <h2>My Certificates</h2>
        <p style="color: var(--text-secondary); max-width: 500px; margin: 0.75rem auto 0;">Professional certifications and achievements.</p>
    </div>
</section>

<section style="padding-bottom: var(--section-gap);">
    <div class="container">
        @if (Model.Count == 0)
        {
            <div class="empty-state">
                <i class="fas fa-certificate"></i>
                <p>No certificates found.</p>
            </div>
        }
        else
        {
            <div class="row reveal-stagger">
                @foreach (var cert in Model)
                {
                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="card h-100">
                            <div class="card-header" style="display: flex; align-items: center; gap: 0.75rem;">
                                @if (!string.IsNullOrEmpty(cert.ImageIconUrl))
                                {
                                    <img src="@cert.ImageIconUrl" alt="@cert.Issuer logo" loading="lazy" style="height: 32px; width: 32px; object-fit: contain; border-radius: 4px;">
                                }
                                else
                                {
                                    <i class="fas fa-certificate" style="color: var(--accent-cyan); font-size: 1.2rem;"></i>
                                }
                                <h6 class="mb-0 text-truncate" style="flex: 1; font-weight: 600; font-size: 0.95rem;">@cert.Title</h6>
                            </div>
                            <div class="card-body d-flex flex-column">
                                <div class="mb-2">
                                    <span class="badge bg-info">@cert.Issuer</span>
                                </div>
                                <p class="card-text" style="color: var(--text-secondary); font-size: 0.85rem; flex: 1;">
                                    @if (!string.IsNullOrEmpty(cert.Description))
                                    {
                                        @(cert.Description.Length > 100 ? cert.Description.Substring(0, 100) + "..." : cert.Description)
                                    }
                                    else
                                    {
                                        <text>No description provided.</text>
                                    }
                                </p>
                                <div class="mb-2">
                                    <small style="color: var(--text-muted); font-size: 0.8rem;">
                                        <i class="fas fa-calendar-alt me-1"></i>Issued: @cert.IssueDate.ToString("MMM yyyy")
                                    </small>
                                    <br />
                                    <small style="color: var(--text-muted); font-size: 0.8rem;">
                                        <i class="fas fa-calendar-times me-1"></i>Expires: @(cert.ExpiryDate.HasValue ? cert.ExpiryDate.Value.ToString("MMM yyyy") : "No Expiry")
                                    </small>
                                </div>
                                @if (!string.IsNullOrEmpty(cert.CredentialId))
                                {
                                    <div class="mb-2">
                                        <small style="color: var(--text-muted); font-size: 0.8rem;">
                                            <i class="fas fa-id-badge me-1"></i>ID: <span style="font-family: var(--font-mono); color: var(--text-secondary);">@cert.CredentialId</span>
                                        </small>
                                    </div>
                                }
                                <div class="mt-auto">
                                    @if (!string.IsNullOrEmpty(cert.CredentialUrl))
                                    {
                                        <a href="@cert.CredentialUrl" class="btn btn-primary btn-sm" target="_blank">
                                            <i class="fas fa-external-link-alt me-1"></i>View Credential
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
