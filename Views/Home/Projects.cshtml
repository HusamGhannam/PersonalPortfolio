@model List<PersonalPortfolio.Models.Project>

@{
    ViewData["Title"] = "Projects";
}

<section class="page-header">
    <div class="container">
        <span class="section-eyebrow">Portfolio</span>
        <h2>My Projects</h2>
        <p style="color: var(--text-secondary); max-width: 500px; margin: 0.75rem auto 0;">A selection of applications and solutions I've built.</p>
    </div>
</section>

<section style="padding-bottom: var(--section-gap);">
    <div class="container">
        @if (Model.Count == 0)
        {
            <div class="empty-state">
                <i class="fas fa-folder-open"></i>
                <p>No projects found.</p>
            </div>
        }
        else
        {
            <div class="row reveal-stagger">
                @foreach (var project in Model)
                {
                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="card project-card h-100">
                            @if (!string.IsNullOrEmpty(project.ImageUrl))
                            {
                                <div style="position: relative; overflow: hidden;">
                                    <img src="@project.ImageUrl" class="card-img-top" alt="@project.Title" loading="lazy" style="height: 200px; object-fit: cover;">
                                    <div style="position: absolute; inset: 0; background: linear-gradient(180deg, transparent 50%, rgba(10, 10, 15, 0.8) 100%);"></div>
                                </div>
                            }
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">@project.Title</h5>
                                <p class="card-text" style="flex: 1;">@project.Description</p>
                                <div class="mb-3">
                                    @foreach (var tech in project.TechStack.Split(','))
                                    {
                                        <span class="badge bg-primary me-1 mb-1">@tech.Trim()</span>
                                    }
                                </div>
                                <div class="mt-auto" style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                                    @if (!string.IsNullOrEmpty(project.LiveUrl))
                                    {
                                        <a href="@project.LiveUrl" class="btn btn-primary btn-sm" target="_blank">
                                            <i class="fas fa-external-link-alt"></i> Live Demo
                                        </a>
                                    }
                                    <a href="https://github.com/HusamGhannam" class="btn btn-sm" style="background: var(--bg-hover); color: var(--text-secondary); border: 1px solid var(--border-subtle);" target="_blank">
                                        <i class="fab fa-github"></i> GitHub
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
