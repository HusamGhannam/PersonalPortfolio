@model PersonalPortfolio.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Panel";
}

<!-- ============================================
     ADMIN DASHBOARD HEADER
     ============================================ -->
<section class="page-header">
    <div class="container">
        <span class="section-eyebrow">Dashboard</span>
        <h2><i class="fas fa-shield-alt me-2" style="color: var(--warning);"></i>Admin Panel</h2>
        <p style="color: var(--text-muted); margin-top: 0.5rem;">Manage your projects, skills, and certificates.</p>
    </div>
</section>

<section style="padding-bottom: var(--section-gap);">
    <div class="container">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Account Actions -->
        <div class="mb-4" style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--card-radius); padding: 1.5rem;">
            <h5 style="border-bottom: 1px solid var(--border-subtle); padding-bottom: 0.75rem; font-weight: 600; font-size: 1rem; margin-bottom: 1rem;">
                <i class="fas fa-user-shield me-2" style="color: var(--warning);"></i>Account
            </h5>
            <a asp-controller="Account" asp-action="ChangePassword" class="btn btn-outline-warning">
                <i class="fas fa-key me-1"></i>Change Password
            </a>
        </div>

        <!-- ============================================
             EXISTING PROJECTS
             ============================================ -->
        <div class="mb-5" style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--card-radius); padding: 1.5rem;">
            <h5 style="border-bottom: 1px solid var(--border-subtle); padding-bottom: 0.75rem; font-weight: 600; font-size: 1rem; margin-bottom: 1rem;">
                <i class="fas fa-folder me-2" style="color: var(--accent-cyan);"></i>Projects
            </h5>
            @if (Model.Projects.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Tech Stack</th>
                                <th class="text-end" style="width: 180px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var project in Model.Projects)
                            {
                                <tr>
                                    <td>
                                        <strong style="color: var(--text-primary);">@project.Title</strong>
                                        <br />
                                        <small style="color: var(--text-muted); font-size: 0.8rem;">@project.Description.Substring(0, Math.Min(80, project.Description.Length))@(project.Description.Length > 80 ? "..." : "")</small>
                                    </td>
                                    <td><span class="badge bg-primary">@project.TechStack</span></td>
                                    <td class="text-end">
                                        <a asp-action="EditProject" asp-route-id="@project.Id" class="btn btn-sm btn-outline-primary me-1">
                                            <i class="fas fa-edit"></i> Edit
                                        </a>
                                        <form asp-action="DeleteProject" asp-route-id="@project.Id" method="post" class="d-inline delete-form">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger delete-btn">
                                                <i class="fas fa-trash"></i> Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p style="color: var(--text-muted); margin-bottom: 0;">No projects yet. Use the form below to add one.</p>
            }
        </div>

        <!-- ============================================
             EXISTING SKILLS
             ============================================ -->
        <div class="mb-5" style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--card-radius); padding: 1.5rem;">
            <h5 style="border-bottom: 1px solid var(--border-subtle); padding-bottom: 0.75rem; font-weight: 600; font-size: 1rem; margin-bottom: 1rem;">
                <i class="fas fa-star me-2" style="color: var(--accent-cyan);"></i>Skills
            </h5>
            @if (Model.Skills.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Category</th>
                                <th>Proficiency</th>
                                <th class="text-end" style="width: 180px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var skill in Model.Skills)
                            {
                                <tr>
                                    <td>
                                        <i class="@skill.IconClass me-2" style="color: var(--accent-cyan);"></i>
                                        <strong style="color: var(--text-primary);">@skill.Name</strong>
                                    </td>
                                    <td><span class="badge bg-info">@skill.Category</span></td>
                                    <td>
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= skill.ProficiencyLevel)
                                            {
                                                <i class="fas fa-circle" style="color: var(--accent-cyan); font-size: 0.6rem; margin-right: 3px;"></i>
                                            }
                                            else
                                            {
                                                <i class="far fa-circle" style="color: var(--text-muted); font-size: 0.6rem; margin-right: 3px;"></i>
                                            }
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="EditSkill" asp-route-id="@skill.Id" class="btn btn-sm btn-outline-primary me-1">
                                            <i class="fas fa-edit"></i> Edit
                                        </a>
                                        <form asp-action="DeleteSkill" asp-route-id="@skill.Id" method="post" class="d-inline delete-form">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger delete-btn">
                                                <i class="fas fa-trash"></i> Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p style="color: var(--text-muted); margin-bottom: 0;">No skills yet. Use the form below to add one.</p>
            }
        </div>

        <!-- ============================================
             EXISTING CERTIFICATES
             ============================================ -->
        <div class="mb-5" style="background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: var(--card-radius); padding: 1.5rem;">
            <h5 style="border-bottom: 1px solid var(--border-subtle); padding-bottom: 0.75rem; font-weight: 600; font-size: 1rem; margin-bottom: 1rem;">
                <i class="fas fa-certificate me-2" style="color: var(--accent-cyan);"></i>Certificates
            </h5>
            @if (Model.Certificates.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Issuer</th>
                                <th>Issue Date</th>
                                <th class="text-end" style="width: 180px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cert in Model.Certificates)
                            {
                                <tr>
                                    <td>
                                        <strong style="color: var(--text-primary);">@cert.Title</strong>
                                        <br />
                                        <small style="color: var(--text-muted); font-size: 0.8rem;">
                                            @(cert.Description != null
                                                ? (cert.Description.Length > 80 ? cert.Description.Substring(0, 80) + "..." : cert.Description)
                                                : "No description")
                                        </small>
                                    </td>
                                    <td><span class="badge bg-info">@cert.Issuer</span></td>
                                    <td><small style="color: var(--text-muted); font-size: 0.8rem;">@cert.IssueDate.ToString("MMM yyyy")</small></td>
                                    <td class="text-end">
                                        <a asp-action="EditCertificate" asp-route-id="@cert.Id" class="btn btn-sm btn-outline-primary me-1">
                                            <i class="fas fa-edit"></i> Edit
                                        </a>
                                        <form asp-action="DeleteCertificate" asp-route-id="@cert.Id" method="post" class="d-inline delete-form">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger delete-btn">
                                                <i class="fas fa-trash"></i> Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p style="color: var(--text-muted); margin-bottom: 0;">No certificates yet. Use the form below to add one.</p>
            }
        </div>

        <!-- ============================================
             ADD NEW ITEMS
             ============================================ -->
        <hr style="border-color: var(--border-subtle); margin: 2rem 0;" />
        <h5 style="font-weight: 600; font-size: 1rem; margin-bottom: 1.25rem;">
            <i class="fas fa-plus-circle me-2" style="color: var(--accent-cyan);"></i>Add New Items
        </h5>

        <div class="row">
            <!-- Add Project Form -->
            <div class="col-md-6 mb-4">
                <div class="card" style="background: var(--bg-surface); border-color: var(--border-subtle);">
                    <div class="card-header" style="background: linear-gradient(135deg, rgba(0, 212, 255, 0.12), rgba(0, 212, 255, 0.04)); border-bottom: 1px solid rgba(0, 212, 255, 0.12); color: var(--accent-cyan); font-weight: 600; font-size: 0.9rem;">
                        <i class="fas fa-folder-plus me-2"></i>Add New Project
                    </div>
                    <div class="card-body">
                        <form asp-action="CreateProject" method="post">
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label for="Title" class="form-label">Title *</label>
                                <input type="text" class="form-control" id="Title" name="Title" required maxlength="200" />
                            </div>

                            <div class="mb-3">
                                <label for="Description" class="form-label">Description *</label>
                                <textarea class="form-control" id="Description" name="Description" rows="3" required maxlength="1000"></textarea>
                            </div>

                            <div class="mb-3">
                                <label for="TechStack" class="form-label">Tech Stack *</label>
                                <input type="text" class="form-control" id="TechStack" name="TechStack" required maxlength="500" placeholder="e.g., ASP.NET Core, Blazor, EF Core" />
                            </div>

                            <div class="mb-3">
                                <label for="ImageUrl" class="form-label">Image URL</label>
                                <input type="url" class="form-control" id="ImageUrl" name="ImageUrl" placeholder="https://placehold.co/600x400" />
                            </div>

                            <div class="mb-3">
                                <label for="LiveUrl" class="form-label">Live URL</label>
                                <input type="url" class="form-control" id="LiveUrl" name="LiveUrl" placeholder="https://example.com" />
                            </div>

                            <button type="submit" class="btn btn-primary w-100">
                                <i class="fas fa-plus me-2"></i>Add Project
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Add Skill Form -->
            <div class="col-md-6 mb-4">
                <div class="card" style="background: var(--bg-surface); border-color: var(--border-subtle);">
                    <div class="card-header" style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.12), rgba(16, 185, 129, 0.04)); border-bottom: 1px solid rgba(16, 185, 129, 0.12); color: var(--success); font-weight: 600; font-size: 0.9rem;">
                        <i class="fas fa-star me-2"></i>Add New Skill
                    </div>
                    <div class="card-body">
                        <form asp-action="CreateSkill" method="post">
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label for="SkillName" class="form-label">Name *</label>
                                <input type="text" class="form-control" id="SkillName" name="Name" required maxlength="100" placeholder="e.g., React, Docker, Azure" />
                            </div>

                            <div class="mb-3">
                                <label for="Category" class="form-label">Category *</label>
                                <select class="form-select" id="Category" name="Category" required>
                                    <option value="">Select a category</option>
                                    <option value="Frontend">Frontend</option>
                                    <option value="Backend">Backend</option>
                                    <option value="Database">Database</option>
                                    <option value="DevOps">DevOps</option>
                                    <option value="AI">AI</option>
                                    <option value="Mobile">Mobile</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label for="ProficiencyLevel" class="form-label">Proficiency Level (1-5) *</label>
                                <input type="number" class="form-control" id="ProficiencyLevel" name="ProficiencyLevel" min="1" max="5" value="3" required />
                                <div class="form-text">1 = Beginner, 5 = Expert</div>
                            </div>

                            <div class="mb-3">
                                <label for="IconClass" class="form-label">Icon Class *</label>
                                <input type="text" class="form-control" id="IconClass" name="IconClass" required maxlength="100" placeholder="e.g., fas fa-react, fas fa-docker" />
                                <div class="form-text">Font Awesome icon class (e.g., fas fa-code)</div>
                            </div>

                            <button type="submit" class="btn btn-success w-100" style="background: var(--success); border-color: var(--success); color: #fff;">
                                <i class="fas fa-plus me-2"></i>Add Skill
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Add Certificate Form -->
            <div class="col-md-6 mb-4">
                <div class="card" style="background: var(--bg-surface); border-color: var(--border-subtle);">
                    <div class="card-header" style="background: linear-gradient(135deg, rgba(124, 58, 237, 0.12), rgba(124, 58, 237, 0.04)); border-bottom: 1px solid rgba(124, 58, 237, 0.12); color: var(--accent-violet); font-weight: 600; font-size: 0.9rem;">
                        <i class="fas fa-certificate me-2"></i>Add New Certificate
                    </div>
                    <div class="card-body">
                        <form asp-action="CreateCertificate" method="post">
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label for="CertTitle" class="form-label">Title *</label>
                                <input type="text" class="form-control" id="CertTitle" name="Title" required maxlength="200" placeholder="e.g., AWS Solutions Architect" />
                            </div>

                            <div class="mb-3">
                                <label for="CertIssuer" class="form-label">Issuer *</label>
                                <input type="text" class="form-control" id="CertIssuer" name="Issuer" required maxlength="200" placeholder="e.g., Amazon Web Services" />
                            </div>

                            <div class="mb-3">
                                <label for="CertIssueDate" class="form-label">Issue Date *</label>
                                <input type="date" class="form-control" id="CertIssueDate" name="IssueDate" required />
                            </div>

                            <div class="mb-3">
                                <label for="CertExpiryDate" class="form-label">Expiry Date</label>
                                <input type="date" class="form-control" id="CertExpiryDate" name="ExpiryDate" />
                            </div>

                            <div class="mb-3">
                                <label for="CertCredentialId" class="form-label">Credential ID</label>
                                <input type="text" class="form-control" id="CertCredentialId" name="CredentialId" maxlength="200" placeholder="e.g., ABC-123-DEF" />
                            </div>

                            <div class="mb-3">
                                <label for="CertCredentialUrl" class="form-label">Credential URL</label>
                                <input type="url" class="form-control" id="CertCredentialUrl" name="CredentialUrl" maxlength="500" placeholder="https://credential-url.com" />
                            </div>

                            <div class="mb-3">
                                <label for="CertDescription" class="form-label">Description</label>
                                <textarea class="form-control" id="CertDescription" name="Description" rows="3" maxlength="1000"></textarea>
                            </div>

                            <div class="mb-3">
                                <label for="CertIconUrl" class="form-label">Issuer Icon URL</label>
                                <input type="url" class="form-control" id="CertIconUrl" name="ImageIconUrl" maxlength="500" placeholder="https://example.com/logo.png" />
                            </div>

                            <button type="submit" class="btn w-100" style="background: var(--accent-violet); border-color: var(--accent-violet); color: #fff;">
                                <i class="fas fa-plus me-2"></i>Add Certificate
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background: var(--danger); border-radius: var(--card-radius) var(--card-radius) 0 0;">
                <h5 class="modal-title" style="color: #fff; font-weight: 600;"><i class="fas fa-exclamation-triangle me-2"></i>Confirm Delete</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="color: var(--text-secondary); padding: 1.5rem;">
                <p>Are you sure you want to delete this item? This action cannot be undone.</p>
            </div>
            <div class="modal-footer" style="border-top: 1px solid var(--border-subtle);">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var activeForm = null;
            var deleteBtns = document.querySelectorAll('.delete-btn');
            var confirmDeleteBtn = document.getElementById('confirmDeleteBtn');
            var deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));

            deleteBtns.forEach(function (btn) {
                btn.addEventListener('click', function (e) {
                    e.preventDefault();
                    activeForm = this.closest('form');
                    deleteModal.show();
                });
            });

            confirmDeleteBtn.addEventListener('click', function () {
                if (activeForm) {
                    activeForm.submit();
                }
                deleteModal.hide();
            });
        });
    </script>
}
